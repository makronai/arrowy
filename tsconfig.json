{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*",
    "bin/**/*",
    "types/**/*",
    "tests/**/*",
    "server.js"
  ]
}
