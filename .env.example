# Array Database Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Storage Provider: 'local' (default) or 'github'
ARRAY_PROVIDER=local

# Local storage data directory (when ARRAY_PROVIDER=local)
ARRAY_DATA_DIR=./.array_data

# GitHub Repository storage credentials (when ARRAY_PROVIDER=github)
ARRAY_GITHUB_OWNER=your-github-username
ARRAY_GITHUB_REPO=your-array-data-repo
ARRAY_GITHUB_BRANCH=main
ARRAY_GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
