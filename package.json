{
  "name": "arrowydb",
  "version": "1.0.1",
  "description": "Dependency-light, GitHub-backed and local file-backed database platform featuring Relational and Document engines with .arr chunk storage.",
  "author": "dwmk",
  "license": "MIT",
  "main": "./packages/core/src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "arrowy": "./bin/array.js",
    "array": "./bin/array.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./packages/core/src/index.js",
      "default": "./packages/core/src/index.js"
    },
    "./relational": {
      "import": "./packages/relational/src/table.js"
    },
    "./document": {
      "import": "./packages/document/src/collection.js"
    },
    "./storage": {
      "import": "./packages/storage/src/provider.js"
    },
    "./format": {
      "import": "./packages/format/src/arr-v1.js"
    },
    "./http": {
      "import": "./packages/http/src/routes.js"
    }
  },
  "files": [
    "packages",
    "bin",
    "types",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "database",
    "github-database",
    "file-backed",
    "arrowy",
    "relational",
    "document-store",
    "nosql",
    "arr-format",
    "serverless-db",
    "vercel"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "tsc --noEmit",
    "preview": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/**/*.test.js",
    "cli": "node bin/array.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
