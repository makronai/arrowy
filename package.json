{
  "name": "arrowy",
  "version": "1.0.0",
  "description": "Dependency-light, GitHub-backed and local file-backed database platform featuring Relational and Document engines with .arr chunk storage.",
  "author": "dwmk",
  "license": "MIT",
  "main": "./packages/core/src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "arrowy": "./bin/array.js",
    "array": "./bin/array.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./packages/core/src/index.js",
      "default": "./packages/core/src/index.js"
    },
    "./relational": {
      "import": "./packages/relational/src/table.js"
    },
    "./document": {
      "import": "./packages/document/src/collection.js"
    },
    "./storage": {
      "import": "./packages/storage/src/provider.js"
    },
    "./format": {
      "import": "./packages/format/src/arr-v1.js"
    },
    "./http": {
      "import": "./packages/http/src/routes.js"
    }
  },
  "files": [
    "packages",
    "bin",
    "types",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "database",
    "github-database",
    "file-backed",
    "relational",
    "document-store",
    "nosql",
    "arr-format",
    "serverless-db",
    "vercel"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "test": "node --test tests/**/*.test.js",
    "cli": "node bin/array.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
